{
  "name": "json-twist",
  "displayName": "JSON Twist - Edge Case Generator",
  "description": "Create JSON edge-case inputs with missing fields, nulls, empty values and wrong types. Preview and copy locally.",
  "version": "0.1.5",
  "publisher": "masum-hasan",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "json",
    "edge cases",
    "test data",
    "fixtures",
    "testing"
  ],
  "icon": "media/icon.png",
  "main": "./dist/src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "jsonEdgeCaseMaker.open",
        "title": "Open",
        "category": "JSON Twist"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "jsonEdgeCaseMaker.open",
          "when": "editorLangId == json",
          "group": "navigation@100"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jsonTwist",
          "title": "JSON Twist",
          "icon": "media/json-twist-activity.svg"
        }
      ]
    },
    "views": {
      "jsonTwist": [
        {
          "id": "jsonTwist.generatedFiles",
          "name": "Generator"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json && node scripts/copy-assets.cjs",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src tests media/*.css docs *.md *.json scripts .github .vscode",
    "format:check": "prettier --check src tests media/*.css docs *.md *.json scripts .github .vscode",
    "test": "npm run compile && node --test dist/tests/unit/*.test.js tests/scripts/vscode-cli.test.mjs",
    "test:integration": "npm run compile && node scripts/test-integration.cjs",
    "test:package": "node scripts/test-package.cjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "vscode:prepublish": "npm run clean && npm run compile",
    "package": "node scripts/package.cjs",
    "package:list": "vsce ls",
    "test:ui": "npm run compile && playwright test",
    "release:check": "node scripts/release-check.cjs",
    "package:release": "npm run release:check && npm run check && npm run package",
    "demo:record": "node scripts/record-demo.cjs"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^10.14.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/masum2617/json-twist.git"
  },
  "bugs": {
    "url": "https://github.com/masum2617/json-twist/issues"
  },
  "homepage": "https://github.com/masum2617/json-twist#readme"
}
